@model Category

<div class="container management-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card management-card mt-3">
                <div class="management-card-header">
                    <span class="product-eyebrow">Catalog management</span>
                    <h1 class="mb-1">
                        Edit Category
                    </h1>
                    <p class="mb-0">Update the category name and display order.</p>
                </div>

                <div class="card-body p-4 p-lg-5">

                    <form method="post">

                        <input asp-for="Id" hidden />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DisplayOrder"
                                   class="form-label">
                            </label>

                            <input asp-for="DisplayOrder"
                                   class="form-control" />

                            <span asp-validation-for="DisplayOrder"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <button type="submit"
                                        class="btn btn-primary w-100 form-primary-button">
                                    Update
                                </button>
                            </div>

                            <div class="col-12 col-sm-6">
                                <a asp-controller="Category"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary w-100">
                                    Back to List
                                </a>
                            </div>
                        </div>

                    </form>

                </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
