@model Category

<div class="container management-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card management-card mt-3">
                <div class="management-card-header">
                    <span class="product-eyebrow">Catalog management</span>
                    <h1 class="mb-1">
                        Delete Category
                    </h1>
                    <p class="mb-0">Review this category before removing it.</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <div class="delete-notice">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>This action cannot be undone.</span>
                    </div>

                    <form method="post">

                        <input asp-for="Id" hidden />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" disabled />
                        </div>

                        <div class="mb-4">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" class="form-control" disabled />
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <button type="submit" class="btn btn-danger w-100 form-primary-button">
                                    Delete
                                </button>
                            </div>

                            <div class="col-12 col-sm-6">
                                <a asp-controller="Category"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary w-100">
                                    Back to List
                                </a>
                            </div>
                        </div>

                    </form>

                </div>
        </div>
    </div>
    </div>
</div>