
@model List<Category>

<div class="container product-management-page py-4 py-lg-5">

    <div class="row pt-4 pb-3 align-items-center">
        <div class="col-12 col-md">
            <span class="product-eyebrow">Catalog management</span>
            <h1 class="product-management-title mb-1">Categories</h1>
            <p class="text-muted mb-0">Organize your products into clear collections.</p>
        </div>

        <div class="col-12 col-md-auto mt-3 mt-md-0">
            <a asp-controller="Category"
               asp-action="Create"
               class="btn btn-primary product-create-button">
                <i class="bi bi-plus-circle"></i>
                Create New Category
            </a>
        </div>
    </div>

    <div class="card product-table-card mt-4">
        <div class="table-responsive">
            <table class="table product-table mb-0">

                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Display Order</th>
                        <th class="text-center" style="width: 190px;">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var obj in Model)
                    {
                        <tr>
                            <td class="align-middle fw-semibold">
                                @obj.Name
                            </td>

                            <td class="align-middle">
                                @obj.DisplayOrder
                            </td>

                            <td class="align-middle">
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-controller="Category"
                                       asp-action="Edit"
                                       asp-route-id="@obj.Id"
                                       class="btn btn-outline-primary btn-sm product-action-button">
                                        <i class="bi bi-pencil-square"></i>
                                        Edit
                                    </a>

                                    <a asp-controller="Category"
                                       asp-action="Delete"
                                       asp-route-id="@obj.Id"
                                       class="btn btn-outline-danger btn-sm product-action-button">
                                        <i class="bi bi-trash-fill"></i>
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>