
@model Bulky.Models.ViewModel.ProductViewModel

<div class="container management-page py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="card management-card mt-3">

                <div class="management-card-header">
                    <span class="product-eyebrow">Catalog management</span>
                    <h1 class="mb-0">
                        @(Model.Product.Id == 0 ? "Create Product" : "Edit Product")
                    </h1>
                    <p class="mb-0">Keep your product information clear and up to date.</p>
                </div>

                <div class="card-body p-4 p-lg-5">

                    <form id="product-form"
                          asp-area="Admin"
                          asp-controller="Product"
                          asp-action="Upsert"
                          method="post"
                          enctype="multipart/form-data"
                          novalidate>

                        <input asp-for="Product.Id" hidden />
                        <input asp-for="Product.ImageUrl" hidden />

                        <div class="row g-4">

                            <!-- Product Fields -->
                            <div class="col-12 col-lg-8">

                                <div asp-validation-summary="All"
                                     class="text-danger mb-3">
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Title" class="form-label"></label>
                                    <input asp-for="Product.Title" class="form-control" />
                                    <span asp-validation-for="Product.Title" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Author" class="form-label"></label>
                                    <input asp-for="Product.Author" class="form-control" />
                                    <span asp-validation-for="Product.Author" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.ISBN" class="form-label"></label>
                                    <input asp-for="Product.ISBN" class="form-control" />
                                    <span asp-validation-for="Product.ISBN" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="SellerPhoneNumber" class="form-label"></label>
                                    @if (Model.Product.Id == 0)
                                    {
                                        <input asp-for="SellerPhoneNumber" class="form-control" autocomplete="tel" />
                                        <span asp-validation-for="SellerPhoneNumber" class="text-danger"></span>
                                        <small class="form-text text-muted">This number appears on the book's details page and updates your profile phone number.</small>
                                    }
                                    else
                                    {
                                        <input value="@Model.SellerPhoneNumber" class="form-control" readonly />
                                        <small class="form-text text-muted">Update this number from your profile.</small>
                                    }
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.CategoryId" class="form-label"></label>

                                    <select asp-for="Product.CategoryId"
                                            asp-items="Model.CategoryList"
                                            class="form-select">
                                        <option value="" disabled>-- Select Category --</option>
                                    </select>

                                    <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Description" class="form-label"></label>
                                    <textarea id="default-editor"
                                              asp-for="Product.Description"
                                              class="form-control"
                                              rows="4"></textarea>
                                    <span asp-validation-for="Product.Description" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.ListPrice" class="form-label"></label>
                                    <input asp-for="Product.ListPrice" class="form-control" />
                                    <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Price" class="form-label"></label>
                                    <input asp-for="Product.Price" class="form-control" />
                                    <span asp-validation-for="Product.Price" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Price50" class="form-label"></label>
                                    <input asp-for="Product.Price50" class="form-control" />
                                    <span asp-validation-for="Product.Price50" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Product.Price100" class="form-label"></label>
                                    <input asp-for="Product.Price100" class="form-control" />
                                    <span asp-validation-for="Product.Price100" class="text-danger"></span>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Product Image</label>
                                    <input type="file"
                                           name="file"
                                           class="form-control"
                                           accept="image/*" />
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-sm-6">
                                        <button type="submit" class="btn btn-primary w-100 form-primary-button">
                                            @(Model.Product.Id == 0 ? "Create" : "Update")
                                        </button>
                                    </div>

                                    <div class="col-12 col-sm-6">
                                        <a asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Index"
                                           class="btn btn-outline-secondary w-100">
                                            Back to List
                                        </a>
                                    </div>
                                </div>

                            </div>

                            <!-- Product Image Preview -->
                            <div class="col-12 col-lg-4">
                                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                                {
                                    <div class="product-upload-preview">
                                        <span class="product-eyebrow">Current cover</span>
                                        <img src="@Model.Product.ImageUrl"
                                             class="img-fluid rounded"
                                             alt="Product cover" />
                                    </div>
                                }
                                else
                                {
                                    <div class="product-upload-empty">
                                        <i class="bi bi-image" aria-hidden="true"></i>
                                        <span>Product cover preview</span>
                                    </div>
                                }
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        tinymce.init({
            selector: '#default-editor',
            plugins: 'anchor autolink charmap codesample emoticons link lists media searchreplace table visualblocks wordcount',
            toolbar: 'undo redo | blocks | bold italic underline | align | bullist numlist | link table | removeformat'
        });

        document.getElementById('product-form').addEventListener('submit', function () {
            tinymce.triggerSave();
        });
    </script>
}
