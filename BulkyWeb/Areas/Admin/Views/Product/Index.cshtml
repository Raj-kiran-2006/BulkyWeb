@model List<Bulky.Models.Product>

<div class="container product-management-page py-4">

    <div class="row pt-4 pb-3 align-items-center">
        <div class="col-12 col-md">
            <span class="product-eyebrow">Catalog</span>
            <h2 class="product-management-title mb-1">Products</h2>
            <p class="text-muted mb-0">Manage your product details and pricing.</p>
        </div>

        <div class="col-12 col-md-auto mt-3 mt-md-0">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Upsert"
               class="btn btn-primary product-create-button">
                <i class="bi bi-plus-circle"></i>
                Create New Product
            </a>
        </div>
    </div>

    <div class="card product-table-card mt-4">
        <div class="table-responsive">
            <table id="tblData" class="table product-table mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>ISBN</th>
                        <th>Price</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/product.js"></script>
}
