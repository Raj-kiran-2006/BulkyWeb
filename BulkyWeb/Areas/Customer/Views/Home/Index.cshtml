@model IEnumerable<Bulky.Models.Product>

<div class="container storefront-page py-4 py-lg-5">
    <header class="storefront-heading">
        <span class="product-eyebrow">The Bulky collection</span>
        <h1>Find your next great read</h1>
        <p>Thoughtfully selected books, ready for your next chapter.</p>
    </header>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <article class="card storefront-product-card h-100">
                    <div class="storefront-cover-frame">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="storefront-cover" alt="Cover of @product.Title" />
                        }
                        else
                        {
                            <div class="product-cover-placeholder">
                                <i class="bi bi-book" aria-hidden="true"></i>
                                <span>No cover available</span>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        @if (product.Category != null)
                        {
                            <span class="product-category align-self-start">@product.Category.Name</span>
                        }
                        <h2 class="storefront-product-title">@product.Title</h2>
                        <p class="storefront-product-author">by @product.Author</p>
                        <div class="storefront-product-price mt-auto">
                            <span>From</span>
                            <strong>@product.Price100.ToString("c")</strong>
                            <span class="storefront-list-price">@product.ListPrice.ToString("c")</span>
                        </div>
                        <a asp-action="Details"
                           asp-route-id="@product.Id"
                           class="btn btn-primary storefront-details-button">
                            View details
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
</div>