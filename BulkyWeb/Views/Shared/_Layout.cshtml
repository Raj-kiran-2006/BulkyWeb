<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BulkyWeb</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BulkyWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link href="https://cdn.datatables.net/v/dt/dt-3.1.4/e-3.1.1/datatables.min.css" rel="stylesheet">
</head>
<body>
    @{
        var isIdentityPage = Context.Request.Path.StartsWithSegments("/Identity", StringComparison.OrdinalIgnoreCase);
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                    Bulky<span class="brand-light">Web</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.IsInRole(SD.Role_Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Content Management
                                    </a>

                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index">Categories</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index">Products</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    <partial name="_LoginPartial" />
                </div>
                <div>

                </div>

            </div>
        </nav>
    </header>
    <main role="main" class="site-main @(isIdentityPage ? "identity-main" : "")">
        <partial name="_Notification" />
        @if (isIdentityPage)
        {
            <div class="container identity-shell">
                <div class="identity-panel">
                    @RenderBody()
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-content">
                <a class="site-footer-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                    Bulky<span>Web</span>
                </a>
                <p class="site-footer-tagline">Thoughtfully selected books, ready for your next chapter.</p>
                <div class="site-footer-bottom">
                    <span>&copy; @DateTime.Now.Year BulkyWeb. All rights reserved.</span>
                    <a asp-area="Customer" asp-controller="Home" asp-action="Privacy">
                        Privacy <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.tiny.cloud/1/iqe5njmyjwyehabmlhg4bln1up6decfhkgpvkl5blr6u8kip/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.4/e-3.1.1/datatables.min.js" ></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
